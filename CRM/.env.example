# Supabase session-pooler URL (port 5432). Also used for `prisma db push`.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Websites allowed to call /api/public/* (comma separated)
PUBLIC_SITE_ORIGIN=http://localhost:3000
# Optional: Supabase Storage for uploaded documents
SUPABASE_URL=
SUPABASE_SECRET_KEY=
